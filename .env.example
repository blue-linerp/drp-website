# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/drp?schema=public"
# openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the site (no trailing slash). Used for OAuth callbacks and links in Discord messages.
AUTH_URL="https://dreamrp.example.com"
NEXT_PUBLIC_SITE_URL="https://dreamrp.example.com"

# ─── Branding (public) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_NAME="Dream Roleplay"
NEXT_PUBLIC_SHORT_NAME="Dream RP"
NEXT_PUBLIC_LOGO_TEXT="DR"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/your-invite"
# Link to your ticket channel (or ticket-bot panel message)
NEXT_PUBLIC_DISCORD_TICKET_URL="https://discord.com/channels/GUILD_ID/TICKET_CHANNEL_ID"
NEXT_PUBLIC_TEBEX_STORE_URL="https://store.dreamrp.example.com"
# cfx.re join code (e.g. abc123) or ip:port. Used for the Connect button + `connect` command.
NEXT_PUBLIC_CFX_JOIN_CODE="cfx.re/join/abc123"
NEXT_PUBLIC_AGE_WHITELIST=18
NEXT_PUBLIC_AGE_PUBLIC=13

# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
WHITELIST_ROLE_ID=""
# Comma-separated role IDs → website permissions
ADMIN_ROLE_IDS=""
SENIOR_STAFF_ROLE_IDS=""
STAFF_ROLE_IDS=""
# department:roleId pairs; department keys match the application type's "department" field
DEPT_HEAD_ROLE_IDS="police:123,ems:456,doj:789"
# Queue priority bonus for anyone with a staff permission
STAFF_PRIORITY_BONUS=200
# Webhooks: new applications → staff channel; decisions/bans/whitelist changes → log channel
APP_WEBHOOK_URL=""
LOG_WEBHOOK_URL=""

# Roles granted on acceptance (used by the seed; editable later in the App builder)
POLICE_ROLE_ID=""
EMS_ROLE_ID=""
DOJ_ROLE_ID=""
STAFF_TRIAL_ROLE_ID=""
GANG_ROLE_ID=""
CREATOR_ROLE_ID=""
# Supporter tier roles + Tebex package IDs / checkout links (seed; editable in Content → Supporter tiers)
SILVER_ROLE_ID=""
GOLD_ROLE_ID=""
DIAMOND_ROLE_ID=""
EMERALD_ROLE_ID=""
TEBEX_SILVER_PACKAGE_ID=""
TEBEX_GOLD_PACKAGE_ID=""
TEBEX_DIAMOND_PACKAGE_ID=""
TEBEX_EMERALD_PACKAGE_ID=""
TEBEX_SILVER_URL=""
TEBEX_GOLD_URL=""
TEBEX_DIAMOND_URL=""
TEBEX_EMERALD_URL=""

# ─── FiveM ────────────────────────────────────────────────────────────────────
# Direct server endpoint for /dynamic.json + /info.json (preferred), e.g. http://1.2.3.4:30120
FIVEM_SERVER_ENDPOINT=""
# Or the cfx join code for the Cfx servers API (used if FIVEM_SERVER_ENDPOINT is empty)
CFX_JOIN_CODE="abc123"
# Shared secret with the drp-gate resource (set drp_gate_secret to the same value). openssl rand -hex 32
FIVEM_API_SECRET=""
# Optional: only accept /api/fivem/* from these IPs (your game server's public IP)
FIVEM_ALLOWED_IPS=""

# ─── Integrations ─────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# Stream titles must contain one of these (case-insensitive) to show as "Live from the city"
TWITCH_SERVER_TAGS="Dream RP,DreamRP,#DreamRP"
# Optional: without it, latest videos come from the channel's public RSS feed
YOUTUBE_API_KEY=""
# Optional: shows the Steam persona name on profiles after linking (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=""
TEBEX_WEBHOOK_SECRET=""
TEBEX_STORE_URL="https://store.dreamrp.example.com"

# ─── Ops ──────────────────────────────────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/sync
CRON_SECRET=""
# Optional: shared rate limiting across serverless instances (otherwise in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Test-only sign-in used by Playwright. NEVER set this in production.
# AUTH_TEST_LOGIN_SECRET=""
